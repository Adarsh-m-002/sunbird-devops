# Max course ids per MGET against the shared Redis when filling the content cache (keep small: values are full content objects)
content_cache_mget_batch_size=50

# Seconds a course id that neither Redis nor the content API returned is remembered as missing (avoids an HTTP call per request)
content_cache_negative_ttl_seconds=60

# Startup pre-warm of the content cache from a SET/HASH of course ids in the shared Redis (empty or absent key = no pre-warm)
