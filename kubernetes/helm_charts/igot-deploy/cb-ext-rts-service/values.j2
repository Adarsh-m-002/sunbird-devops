### Default variable file for cb_ext_rts_service ###

namespace: {{ namespace }}
imagepullsecrets: {{ imagepullsecrets }}
dockerhub: {{ docker_hub_url }}


env:
  javaoptions: {{cb_ext_rts_java_mem_limit|default('-Xmx600m')}}

replicaCount: {{cb_ext_rts_replicacount|default(2)}}
repository: {{ image_cb_ext_rts_service }}
image_tag: {{image_tag}}
resources:
  requests:
    cpu: {{cb_ext_rts_cpu_req|default('100m')}}
    memory: {{cb_ext_rts_mem_req|default('100Mi')}}
  limits:
    cpu: {{cb_ext_rts_cpu_limit|default('1')}}
    memory: {{cb_ext_rts_mem_limit|default('1024Mi')}}
network:
  port: {{ service_cb_ext_rts_port }}
  targetport: {{ service_cb_ext_rts_port }}
strategy:
  type: RollingUpdate
  maxsurge: {{ cb_ext_rts_maxsurge|default('25%') }}
  maxunavailable: {{ cb_ext_rts_maxunavailable|default('25%') }}

cb_ext_rts_backend_basepath: {{ cb_ext_rts_backend_basepath | default('/keys/') }}


serviceMonitor:
  enabled: true
  labels: # labels with which the prometheus choose the serviceMonitor
    app: prometheus-operator
    release: prometheus-operator

autoscaling:
  enabled: {{ cb_ext_rts_service_autoscaling_enabled | default('false') }}
  minReplicas: {{ cb_ext_rts_service_autoscaling_minReplicas|default(1) }}
  maxReplicas: {{ cb_ext_rts_service_autoscaling_maxReplicas|default(2) }}
  targetCPUUtilizationPercentage: {{ cb_ext_rts_service_autoscaling_targetCPUUtilizationPercentage|default(60) }}
  targetMemoryUtilizationPercentage: {{ cb_ext_rts_service_autoscaling_targetMemoryUtilizationPercentage|default('') }}

